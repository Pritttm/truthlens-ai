# ─────────────────────────────────────────────────
# TruthLens AI – Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────

# Required: OpenAI API key for LLM reasoning
OPENAI_API_KEY=sk-...

# Optional: override the LLM model (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: embedding model from HuggingFace Hub
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: directory where ChromaDB persists vectors
CHROMA_PERSIST_DIR=./chroma_db

# Optional: CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

OPENAI_API_KEY=sk-your-real-key-here